# Microsoft Graph credentials for resolving Intune app GUIDs -> names.
# Copy to ".env" (gitignored) and fill in. Two modes:
#
#  1) Device-code (delegated) — simplest, no secret to store. Set TENANT + CLIENT.
#     The Azure AD app needs delegated "DeviceManagementApps.Read.All" and a
#     "public client / native" redirect (allow public client flows = yes).
#     An Intune admin signs in once; the token is cached under data/.
#
#  2) App-only (client credentials) — unattended. Also set CLIENT_SECRET.
#     The app needs the *application* permission "DeviceManagementApps.Read.All"
#     with admin consent granted.

GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_SECRET=your-secret-here   # uncomment for app-only mode
